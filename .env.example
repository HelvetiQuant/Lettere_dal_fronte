# ─── Database Configuration ────────────────────────────────────────────────────

# SQLite (default — no DATABASE_URL needed)
# Il DB locale viene usato automaticamente se DATABASE_URL non è impostato.

# PostgreSQL / Supabase
# Impostare DATABASE_URL per usare PostgreSQL invece di SQLite.
# Formato Supabase:
#   DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0.[region].supabase.com:5432/postgres
# Esempio:
#   DATABASE_URL=postgresql://postgres.abcdefgh:MyPassword123@aws-0.eu-central-1.supabase.com:5432/postgres

# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0.REGION.supabase.com:5432/postgres

# ─── API Keys ──────────────────────────────────────────────────────────────────

OPENAI_API_KEY=sk-...
MISTRAL_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...

# ─── Server ────────────────────────────────────────────────────────────────────

HOST=127.0.0.1
PORT=8123
