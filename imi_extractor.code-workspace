{
	"folders": [
		{
			"name": "IMI Extractor",
			"path": "."
		},
		{
			"name": "OCR Lettere",
			"path": "../ocr_lettere"
		}
	],
	"settings": {
		"python.defaultInterpreterPath": "${workspaceFolder:IMI Extractor}/.venv/Scripts/python.exe",
		"files.exclude": {
			"**/__pycache__": true,
			"**/.pytest_cache": true,
			"**/*.pyc": true
		},
		"search.exclude": {
			"**/_*.py": true,
			"**/nara_scrape.log": true,
			"**/cwgc_log.txt": true,
			"**/cwgc_err.txt": true,
			"**/nara_err.log": true
		},
		"editor.tabSize": 4,
		"editor.insertSpaces": true,
		"files.encoding": "utf8"
	},
	"workbenchMode": "windsurf-agent-window"
}